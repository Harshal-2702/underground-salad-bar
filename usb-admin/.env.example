# Copy this file to .env.local and fill in values locally.
# Local development uses VITE_API_URL.
VITE_API_URL=http://localhost:5000

# Vercel Preview deployments use VITE_PREVIEW_API_URL (staging API only).
VITE_PREVIEW_API_URL=https://ukos-staging-api.onrender.com

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
