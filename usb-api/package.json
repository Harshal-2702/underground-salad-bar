{
  "name": "usb-api",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --test src/services/pricing.test.ts src/services/order-delivery.test.ts src/services/ingredient-validation.test.ts src/services/kot.test.ts",
    "seed:catalogue:local": "node --import tsx src/scripts/seed-ingredient-catalogue.ts",
    "test:integration:local": "node --import tsx --test src/services/ingredient-catalogue.integration.test.ts src/services/recipe.integration.test.ts src/services/kot.integration.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.110.8",
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
